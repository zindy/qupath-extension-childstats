<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<fx:root type="VBox" spacing="8" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity"
         xmlns="http://javafx.com/javafx/20" xmlns:fx="http://javafx.com/fxml/1">
    <padding>
        <Insets topRightBottomLeft="8"/>
    </padding>

    <!-- Child object type + class filter -->
    <HBox spacing="6" alignment="CENTER_LEFT">
        <Label text="%option.childType.text"/>
        <ComboBox fx:id="childTypeCombo" prefWidth="120.0"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label text="%option.childClass.text"/>
        <ComboBox fx:id="childClassCombo" prefWidth="150.0"/>
    </HBox>

    <Separator/>

    <!-- Measurement picker: available / selected -->
    <Label text="%option.measurements.text"/>
    <HBox spacing="4">
        <VBox spacing="2" HBox.hgrow="ALWAYS">
            <Label text="%option.available.text"/>
            <ListView fx:id="availableList" prefHeight="160.0" VBox.vgrow="ALWAYS"/>
        </VBox>
        <VBox spacing="4" alignment="CENTER">
            <Button fx:id="addButton" text="%option.add" maxWidth="Infinity"/>
            <Button fx:id="addAllButton" text="%option.addAll" maxWidth="Infinity"/>
            <Button fx:id="removeButton" text="%option.remove" maxWidth="Infinity"/>
            <Button fx:id="clearButton" text="%option.clear" maxWidth="Infinity"/>
        </VBox>
        <VBox spacing="2" HBox.hgrow="ALWAYS">
            <Label text="%option.selected.text"/>
            <ListView fx:id="selectedList" prefHeight="160.0" VBox.vgrow="ALWAYS"/>
        </VBox>
    </HBox>
    <TextField fx:id="measurementFilterField" promptText="%option.measurementFilter.prompt"/>

    <Separator/>

    <!-- Statistics -->
    <Label text="%option.stats.text"/>
    <FlowPane hgap="10" vgap="4">
        <CheckBox fx:id="meanCheck" text="%option.stat.mean" selected="true"/>
        <CheckBox fx:id="stdevCheck" text="%option.stat.stdev" selected="true"/>
        <CheckBox fx:id="medianCheck" text="%option.stat.median"/>
        <CheckBox fx:id="minCheck" text="%option.stat.min"/>
        <CheckBox fx:id="maxCheck" text="%option.stat.max"/>
        <CheckBox fx:id="sumCheck" text="%option.stat.sum"/>
        <CheckBox fx:id="cvCheck" text="%option.stat.cv"/>
        <HBox spacing="4" alignment="CENTER_LEFT">
            <CheckBox fx:id="percentileCheck" text="%option.stat.percentile"/>
            <Spinner fx:id="percentileSpinner" prefWidth="70.0" disable="true" editable="true">
                <valueFactory>
                    <SpinnerValueFactory.DoubleSpinnerValueFactory min="0.0" max="100.0" initialValue="90.0" amountToStepBy="1.0"/>
                </valueFactory>
            </Spinner>
        </HBox>
    </FlowPane>

    <Separator/>

    <!-- Behaviour -->
    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="%option.missing.text"/>
        <ComboBox fx:id="missingPolicyCombo" prefWidth="110.0"/>
        <CheckBox fx:id="overwriteCheck" text="%option.overwrite.text" selected="true"/>
    </HBox>
    <HBox spacing="6" alignment="CENTER_LEFT">
        <Label text="%option.nameFormat.text"/>
        <TextField fx:id="nameFormatField" HBox.hgrow="ALWAYS"/>
    </HBox>

    <Separator/>

    <!-- Scope -->
    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="%option.scope.text"/>
        <RadioButton fx:id="currentImageRadio" text="%option.scope.currentImage" selected="true">
            <toggleGroup>
                <ToggleGroup fx:id="scopeGroup"/>
            </toggleGroup>
        </RadioButton>
        <RadioButton fx:id="wholeProjectRadio" text="%option.scope.wholeProject" toggleGroup="$scopeGroup"/>
    </HBox>

    <Separator/>

    <!-- Preview -->
    <HBox spacing="6" alignment="CENTER_LEFT">
        <Button fx:id="previewButton" onAction="#runPreview" text="%option.preview.button"/>
        <Label fx:id="previewHintLabel" text="%option.preview.hint" wrapText="true"/>
    </HBox>
    <TableView fx:id="previewTable" prefHeight="120.0">
        <columns>
            <TableColumn fx:id="previewMeasurementColumn" text="%option.preview.column.measurement" prefWidth="260.0"/>
            <TableColumn fx:id="previewValueColumn" text="%option.preview.column.value" prefWidth="90.0"/>
            <TableColumn fx:id="previewCountColumn" text="%option.preview.column.n" prefWidth="50.0"/>
        </columns>
    </TableView>

    <HBox spacing="6" alignment="CENTER_RIGHT">
        <ProgressBar fx:id="runProgressBar" prefWidth="180.0" progress="0.0" visible="false"/>
        <Button fx:id="runButton" onAction="#runAggregation" text="%option.run.button"/>
    </HBox>

</fx:root>
